<Window x:Class="xMenuForge.Settings.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="xMenuForge"
        Width="1120" Height="640"
        MinWidth="860" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgWindowBrush}"
        WindowStyle="None"
        ResizeMode="CanResize"
        StateChanged="Window_StateChanged"
        Closing="Window_Closing">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="10"/>
    </WindowChrome.WindowChrome>

    <Border x:Name="RootFrameBorder" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" Background="{StaticResource BgWindowBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Custom Dark Title Bar -->
            <Border Grid.Row="0" Background="{StaticResource BgSidebarBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                <Grid Margin="14,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="pack://application:,,,/Assets/AppIcon.png" Width="22" Height="22" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="xMenuForge" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Border Background="#1D273B" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="v1.0" FontSize="11" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                        </Border>
                        <TextBlock x:Name="SaveStatusText" Text="All changes saved" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="16,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="MinBtn" Width="36" Height="28" Padding="0" ToolTip="Minimize"
                                Style="{StaticResource SecondaryButton}" Background="Transparent" BorderThickness="0" Click="Minimize_Click">
                            <Path Data="M0,5 L10,5" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.3" Width="10" Height="10" Stretch="None"/>
                        </Button>
                        <Button x:Name="MaxBtn" Width="36" Height="28" Padding="0" ToolTip="Maximize / Restore"
                                Style="{StaticResource SecondaryButton}" Background="Transparent" BorderThickness="0" Click="Maximize_Click">
                            <Path x:Name="MaxGlyph" Data="M1,1 L9,1 L9,9 L1,9 Z" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.3" Width="10" Height="10" Stretch="None"/>
                        </Button>
                        <Button x:Name="CloseBtn" Width="36" Height="28" Padding="0" ToolTip="Close"
                                Style="{StaticResource SecondaryButton}" Background="Transparent" BorderThickness="0" Click="Close_Click">
                            <Path Data="M1,1 L9,9 M9,1 L1,9" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.3" Width="10" Height="10" Stretch="None"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Content Split: Sidebar + Active Section -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="216"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Navigation Sidebar (All 9 Sections) -->
                <Border Grid.Column="0" Background="{StaticResource BgSidebarBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,1,0">
                    <DockPanel LastChildFill="False">
                        <StackPanel DockPanel.Dock="Top" Margin="0,10,0,0">
                            <TextBlock Text="WORKSPACE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="18,4,0,6"/>
                            <RadioButton x:Name="NavOverview" Style="{StaticResource NavButton}" IsChecked="True" Tag="Overview" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE80F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Overview" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavDesigner" Style="{StaticResource NavButton}" Tag="MenuDesigner" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8FD;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Menu Designer" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavCommands" Style="{StaticResource NavButton}" Tag="Commands" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE756;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Commands" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavCustom" Style="{StaticResource NavButton}" Tag="CustomCommands" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE943;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Custom Commands" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <TextBlock Text="BEHAVIOR &amp; STYLE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="18,14,0,6"/>
                            <RadioButton x:Name="NavExecution" Style="{StaticResource NavButton}" Tag="Execution" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Execution" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavAppearance" Style="{StaticResource NavButton}" Tag="Appearance" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE790;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Appearance" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavContextRules" Style="{StaticResource NavButton}" Tag="ContextRules" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE71C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Context Rules" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>

                            <TextBlock Text="SYSTEM" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="18,14,0,6"/>
                            <RadioButton x:Name="NavIntegrations" Style="{StaticResource NavButton}" Tag="Integrations" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE838;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Integrations" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavDiagnostics" Style="{StaticResource NavButton}" Tag="Diagnostics" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE9D9;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Diagnostics" VerticalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <Border DockPanel.Dock="Bottom" Margin="12" Padding="10" CornerRadius="8" Background="{StaticResource BgCardBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="SidebarStatusDot" Width="8" Height="8" Fill="{StaticResource WarningBrush}" Margin="0,0,8,0"/>
                                    <TextBlock x:Name="SidebarStatusLabel" Text="Checking Explorer..." FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>
                                <TextBlock Text="Windows 11 Shell Platform" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Border>
                    </DockPanel>
                </Border>

                <!-- Active Page Host -->
                <Grid Grid.Column="1" Margin="22,18,22,18">

                    <!-- 1. OVERVIEW -->
                    <ScrollViewer x:Name="PageOverview" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Overview" FontSize="22" FontWeight="SemiBold"/>
                            <TextBlock Text="Your Windows. Your commands. Your context menu." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,16"/>

                            <UniformGrid Columns="3" Margin="0,0,0,16">
                                <Border Style="{StaticResource CardBorder}" Margin="0,0,10,0">
                                    <StackPanel>
                                        <TextBlock Text="EXPLORER INTEGRATION" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock x:Name="OverviewRegStatus" Text="Checking..." FontSize="18" FontWeight="SemiBold" Margin="0,6,0,4"/>
                                        <TextBlock x:Name="OverviewRegDetail" Text="Modern Win11 Sparse Package" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardBorder}" Margin="5,0,5,0">
                                    <StackPanel>
                                        <TextBlock Text="ACTIVE COMMANDS" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock x:Name="OverviewCmdCount" Text="0" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,4"/>
                                        <TextBlock x:Name="OverviewCustomCount" Text="0 custom commands" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource CardBorder}" Margin="10,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="SUBMENU STRATEGY" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock x:Name="OverviewSubmenuMode" Text="Category Flyout" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,4"/>
                                        <TextBlock Text="Compliant with Win11 IExplorerCommand" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Quick Actions" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    <WrapPanel>
                                        <Button Content="+ New Custom Command" Style="{StaticResource PrimaryButton}" Margin="0,0,10,6" Click="QuickNewCustom_Click"/>
                                        <Button Content="Open Menu Designer" Style="{StaticResource SecondaryButton}" Margin="0,0,10,6" Click="QuickOpenDesigner_Click"/>
                                        <Button Content="Register / Repair Explorer" Style="{StaticResource SecondaryButton}" Margin="0,0,10,6" Click="RegisterExplorer_Click"/>
                                        <Button Content="Import from xToolsMenu" Style="{StaticResource SecondaryButton}" Margin="0,0,10,6" Click="ImportXToolsMenu_Click"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <TextBlock Text="Recent Command Activity" FontSize="14" FontWeight="SemiBold" DockPanel.Dock="Left"/>
                                        <Button Content="Refresh" Style="{StaticResource SecondaryButton}" Padding="10,4" HorizontalAlignment="Right" Click="RefreshLogs_Click"/>
                                    </DockPanel>
                                    <ListBox x:Name="OverviewActivityList" Height="210" BorderThickness="0" Background="Transparent"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 2. MENU DESIGNER -->
                    <Grid x:Name="PageMenuDesigner" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Text="Menu Designer" FontSize="22" FontWeight="SemiBold"/>
                            <TextBlock Text="Drag and drop items to reorder, nest into categories, or add separators. Preview updates live." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <WrapPanel Grid.Row="1" Margin="0,0,0,12">
                            <Button Content="+ Add Category" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0" Click="DesignerAddCategory_Click"/>
                            <Button Content="+ Add Separator" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="DesignerAddSeparator_Click"/>
                            <Button Content="Move Up" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="DesignerMoveUp_Click"/>
                            <Button Content="Move Down" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="DesignerMoveDown_Click"/>
                            <Button Content="Nest Into Category" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="DesignerNest_Click"/>
                            <Button Content="Move to Root" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="DesignerUnnest_Click"/>
                            <Button Content="Toggle Enabled" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="DesignerToggleEnabled_Click"/>
                            <ComboBox x:Name="DesignerModifierCombo" Width="138" Margin="0,0,8,0" ToolTip="Set modifier key for selected item" SelectionChanged="DesignerModifier_Changed">
                                <ComboBoxItem Content="Key: Always" Tag="none"/>
                                <ComboBoxItem Content="Key: Hold Ctrl" Tag="ctrl"/>
                                <ComboBoxItem Content="Key: Hold Shift" Tag="shift"/>
                                <ComboBoxItem Content="Key: Hold Alt" Tag="alt"/>
                                <ComboBoxItem Content="Key: Ctrl+Shift" Tag="ctrl_shift"/>
                            </ComboBox>
                            <Button Content="Delete" Style="{StaticResource DangerButton}" Click="DesignerDelete_Click"/>
                        </WrapPanel>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.25*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="0.95*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="10">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Text="Menu Hierarchy (drag to reorder)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="4,0,0,8"/>
                                    <ListBox x:Name="DesignerList" AllowDrop="True"
                                             SelectionChanged="DesignerList_SelectionChanged"
                                             PreviewMouseLeftButtonDown="DesignerList_PreviewMouseLeftButtonDown"
                                             PreviewMouseMove="DesignerList_PreviewMouseMove"
                                             Drop="DesignerList_Drop"
                                             BorderThickness="0" Background="Transparent"/>
                                </DockPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                        <TextBlock Text="Live Context Menu Preview" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="PreviewContextCombo" Grid.Column="0" SelectionChanged="PreviewContext_Changed">
                                                <ComboBoxItem Content="File (example.ps1)" IsSelected="True" Tag="file"/>
                                                <ComboBoxItem Content="Folder (C:\Projects)" Tag="folder"/>
                                                <ComboBoxItem Content="Directory Background" Tag="background"/>
                                            </ComboBox>
                                            <ComboBox x:Name="PreviewModifierCombo" Grid.Column="2" SelectionChanged="PreviewContext_Changed">
                                                <ComboBoxItem Content="Normal Click" IsSelected="True" Tag="none"/>
                                                <ComboBoxItem Content="Hold Ctrl" Tag="ctrl"/>
                                                <ComboBoxItem Content="Hold Shift" Tag="shift"/>
                                                <ComboBoxItem Content="Hold Alt" Tag="alt"/>
                                                <ComboBoxItem Content="Hold Ctrl + Shift" Tag="ctrl_shift"/>
                                            </ComboBox>
                                        </Grid>
                                    </StackPanel>
                                    <Border Background="#111318" BorderBrush="#2E3545" BorderThickness="1" CornerRadius="8" Padding="8">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                            <StackPanel x:Name="LivePreviewPanel"/>
                                        </ScrollViewer>
                                    </Border>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- 3. BUILT-IN COMMANDS -->
                    <Grid x:Name="PageCommands" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,0,0,14">
                            <TextBlock Text="Built-in Commands" FontSize="22" FontWeight="SemiBold"/>
                            <TextBlock Text="All xToolsMenu essentials carried forward natively — enable, rename, or configure context visibility." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="BuiltInCommandsPanel"/>
                        </ScrollViewer>
                    </Grid>

                    <!-- 4. CUSTOM COMMANDS -->
                    <Grid x:Name="PageCustomCommands" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,12">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="Custom Commands" FontSize="22" FontWeight="SemiBold"/>
                                <TextBlock Text="Create unlimited PowerShell, CMD, Windows Terminal, or GUI commands with full console visibility control." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button Content="+ Add Custom Command" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Click="AddCustomCommand_Click"/>
                        </DockPanel>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="8">
                                <ListBox x:Name="CustomList" SelectionChanged="CustomList_SelectionChanged" BorderThickness="0" Background="Transparent"/>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="CustomEditorPanel" IsEnabled="False">
                                        <DockPanel Margin="0,0,0,12">
                                            <TextBlock Text="Command Configuration" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Content="Test Run" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="CustomTestRun_Click"/>
                                                <Button Content="Delete" Style="{StaticResource DangerButton}" Click="CustomDelete_Click"/>
                                            </StackPanel>
                                        </DockPanel>

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="180"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Display Name" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <TextBox x:Name="CustomTitleBox"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Runner Type" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <ComboBox x:Name="CustomRunnerTypeCombo">
                                                    <ComboBoxItem Content="Executable / GUI App" Tag="executable"/>
                                                    <ComboBoxItem Content="PowerShell Script / Cmd" Tag="powershell"/>
                                                    <ComboBoxItem Content="CMD Command" Tag="cmd"/>
                                                    <ComboBoxItem Content="Windows Terminal" Tag="windows_terminal"/>
                                                </ComboBox>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="Executable Path or Script / Command" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="CustomExeBox" Grid.Column="0"/>
                                            <Button Content="Browse..." Style="{StaticResource SecondaryButton}" Grid.Column="2" Click="CustomBrowseExe_Click"/>
                                        </Grid>

                                        <TextBlock Text="Arguments Template  (tokens: {path} {paths} {dir} {name} {stem} {ext})" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                        <TextBox x:Name="CustomArgsBox" Margin="0,0,0,10"/>

                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Console Visibility" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <ComboBox x:Name="CustomVisibilityCombo">
                                                    <ComboBoxItem Content="Default (Inherit)" Tag="default"/>
                                                    <ComboBoxItem Content="Show Window" Tag="show"/>
                                                    <ComboBoxItem Content="Hide Window" Tag="hide"/>
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Working Directory" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <ComboBox x:Name="CustomWorkDirCombo">
                                                    <ComboBoxItem Content="Target Folder" Tag="target"/>
                                                    <ComboBoxItem Content="Parent Folder" Tag="parent"/>
                                                    <ComboBoxItem Content="Custom Path" Tag="custom"/>
                                                </ComboBox>
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <TextBlock Text="Category" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <ComboBox x:Name="CustomCategoryCombo"/>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock Text="Icon Path (optional — .ico or .exe)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="CustomIconBox" Grid.Column="0"/>
                                            <Button Content="Browse..." Style="{StaticResource SecondaryButton}" Grid.Column="2" Click="CustomBrowseIcon_Click"/>
                                        </Grid>

                                        <WrapPanel Margin="0,4,0,12">
                                            <CheckBox x:Name="CustomShowFilesChk" Content="Files" Margin="0,0,18,6"/>
                                            <CheckBox x:Name="CustomShowFoldersChk" Content="Folders" Margin="0,0,18,6"/>
                                            <CheckBox x:Name="CustomShowBgChk" Content="Directory Background" Margin="0,0,18,6"/>
                                            <CheckBox x:Name="CustomAdminChk" Content="Run as Administrator" Margin="0,0,18,6"/>
                                            <CheckBox x:Name="CustomLogChk" Content="Log Hidden Output" Margin="0,0,18,6"/>
                                        </WrapPanel>

                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="210"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Extension Filter (optional, comma-separated e.g. .ps1, .json, .md)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <TextBox x:Name="CustomExtsBox"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Modifier Key to Reveal" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"/>
                                                <ComboBox x:Name="CustomModifierCombo">
                                                    <ComboBoxItem Content="Always (Normal Click)" Tag="none"/>
                                                    <ComboBoxItem Content="Hold Ctrl" Tag="ctrl"/>
                                                    <ComboBoxItem Content="Hold Shift (Classic)" Tag="shift"/>
                                                    <ComboBoxItem Content="Hold Alt" Tag="alt"/>
                                                    <ComboBoxItem Content="Hold Ctrl + Shift" Tag="ctrl_shift"/>
                                                </ComboBox>
                                            </StackPanel>
                                        </Grid>

                                        <Button Content="Save Custom Command" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="CustomSave_Click"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- 5. EXECUTION -->
                    <ScrollViewer x:Name="PageExecution" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                            <TextBlock Text="Execution" FontSize="22" FontWeight="SemiBold"/>
                            <TextBlock Text="Control default console visibility, shell binaries, timeouts, and hidden command logging." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,16"/>

                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Console &amp; Shell Defaults" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="240"/>
                                            <ColumnDefinition Width="260"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Default Console Visibility" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <ComboBox x:Name="ExecDefaultVisCombo" Grid.Column="1">
                                            <ComboBoxItem Content="Show Window" Tag="show"/>
                                            <ComboBoxItem Content="Hide Window" Tag="hide"/>
                                        </ComboBox>
                                    </Grid>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="240"/>
                                            <ColumnDefinition Width="260"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Preferred PowerShell" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <ComboBox x:Name="ExecPsCombo" Grid.Column="1">
                                            <ComboBoxItem Content="Auto (PowerShell 7 if installed)" Tag="auto"/>
                                            <ComboBoxItem Content="PowerShell 7 (pwsh.exe)" Tag="pwsh"/>
                                            <ComboBoxItem Content="Windows PowerShell (powershell.exe)" Tag="powershell"/>
                                        </ComboBox>
                                    </Grid>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="240"/>
                                            <ColumnDefinition Width="260"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Windows Terminal Profile (optional)" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBox x:Name="ExecWtProfileBox" Grid.Column="1"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="240"/>
                                            <ColumnDefinition Width="120"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Default Timeout (seconds)" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBox x:Name="ExecTimeoutBox" Grid.Column="1"/>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Logging &amp; Error Visibility" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                    <CheckBox x:Name="ExecEnableLogChk" Style="{StaticResource ToggleSwitch}" Content="Record command execution history (executions.jsonl)" Margin="0,0,0,10"/>
                                    <CheckBox x:Name="ExecLogHiddenChk" Style="{StaticResource ToggleSwitch}" Content="Capture stdout/stderr for hidden commands so failures are never lost" Margin="0,0,0,10"/>
                                    <CheckBox x:Name="ExecNotifyErrChk" Style="{StaticResource ToggleSwitch}" Content="Flag non-zero exit codes in Diagnostics"/>
                                </StackPanel>
                            </Border>

                            <Button Content="Save Execution Settings" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="SaveExecution_Click"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 6. APPEARANCE -->
                    <ScrollViewer x:Name="PageAppearance" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                            <TextBlock Text="Appearance" FontSize="22" FontWeight="SemiBold"/>
                            <TextBlock Text="Personalize your root context menu title, icon theme, and Windows 11 submenu presentation." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,16"/>

                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Root Menu Presentation" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="240"/>
                                            <ColumnDefinition Width="320"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Root Menu Label" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBox x:Name="AppRootTitleBox" Grid.Column="1"/>
                                    </Grid>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="240"/>
                                            <ColumnDefinition Width="320"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Icon Theme" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <ComboBox x:Name="AppIconThemeCombo" Grid.Column="1">
                                            <ComboBoxItem Content="Auto (Follow Windows Theme)" Tag="auto"/>
                                            <ComboBoxItem Content="Dark Icons (Light Glyphs)" Tag="dark"/>
                                            <ComboBoxItem Content="Light Icons (Dark Glyphs)" Tag="light"/>
                                        </ComboBox>
                                    </Grid>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="240"/>
                                            <ColumnDefinition Width="320"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Modern Win11 Category Mode" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <ComboBox x:Name="AppSubmenuModeCombo" Grid.Column="1">
                                            <ComboBoxItem Content="Category Flyout (Cursor Popup for Nested Menus)" Tag="flyout"/>
                                            <ComboBoxItem Content="Flatten with Visual Separators" Tag="flatten"/>
                                        </ComboBox>
                                    </Grid>
                                    <CheckBox x:Name="AppShowIconsChk" Style="{StaticResource ToggleSwitch}" Content="Show icons beside context menu commands"/>
                                </StackPanel>
                            </Border>

                            <Button Content="Save Appearance Settings" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="SaveAppearance_Click"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 7. CONTEXT RULES -->
                    <Grid x:Name="PageContextRules" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Text="Context Rules" FontSize="22" FontWeight="SemiBold"/>
                            <TextBlock Text="Control exactly where every command appears: files, folders, directory backgrounds, file categories, and extensions." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="8">
                                <ListBox x:Name="RulesCommandList" SelectionChanged="RulesCommandList_SelectionChanged" BorderThickness="0" Background="Transparent"/>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel x:Name="RulesEditorPanel" IsEnabled="False">
                                        <TextBlock x:Name="RulesSelectedTitle" Text="Select a command" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12"/>

                                        <TextBlock Text="Target Surfaces" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                        <WrapPanel Margin="0,0,0,14">
                                            <CheckBox x:Name="RuleFilesChk" Content="Selected Files" Margin="0,0,20,8"/>
                                            <CheckBox x:Name="RuleFoldersChk" Content="Selected Folders" Margin="0,0,20,8"/>
                                            <CheckBox x:Name="RuleBgChk" Content="Folder Background" Margin="0,0,20,8"/>
                                            <CheckBox x:Name="RuleMultiChk" Content="Allow Multi-Selection" Margin="0,0,20,8"/>
                                        </WrapPanel>

                                        <TextBlock Text="File Categories (leave all unchecked to allow every file type)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                                        <WrapPanel x:Name="RuleCategoriesPanel" Margin="0,0,0,14"/>

                                        <TextBlock Text="Modifier Key to Reveal (reduces everyday menu clutter)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                        <ComboBox x:Name="RuleModifierCombo" Width="320" HorizontalAlignment="Left" Margin="0,0,0,4">
                                            <ComboBoxItem Content="Always Show (Normal Right-Click)" Tag="none"/>
                                            <ComboBoxItem Content="Hold Ctrl (Modern Win11 &amp; Classic)" Tag="ctrl"/>
                                            <ComboBoxItem Content="Hold Shift (Classic / Extended Menu)" Tag="shift"/>
                                            <ComboBoxItem Content="Hold Alt (Modern Win11 &amp; Classic)" Tag="alt"/>
                                            <ComboBoxItem Content="Hold Ctrl + Shift" Tag="ctrl_shift"/>
                                        </ComboBox>
                                        <TextBlock Text="Tip: Hold Ctrl or Alt to reveal extra items inside the Windows 11 Modern menu. Windows 11 opens the Classic menu on Shift + Right-Click."
                                                   FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,0,0,14"/>

                                        <TextBlock Text="Specific File Extensions (comma-separated, e.g. .ps1, .json, .cpp)" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                                        <TextBox x:Name="RuleExtensionsBox" Margin="0,0,0,16"/>

                                        <Button Content="Save Context Rules" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="SaveContextRules_Click"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- 8. INTEGRATIONS -->
                    <ScrollViewer x:Name="PageIntegrations" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel MaxWidth="780" HorizontalAlignment="Left">
                            <TextBlock Text="Integrations" FontSize="22" FontWeight="SemiBold"/>
                            <TextBlock Text="Manage Windows 11 Modern Explorer Sparse Package registration and optional Classic Context Menu integration." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,16"/>

                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Explorer Registration Modes" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    <CheckBox x:Name="IntegModernChk" Style="{StaticResource ToggleSwitch}" Content="Windows 11 Modern Context Menu (IExplorerCommand Sparse Package)" Margin="0,0,0,10"/>
                                    <CheckBox x:Name="IntegClassicChk" Style="{StaticResource ToggleSwitch}" Content="Classic Context Menu ('Show more options' — native multi-level HMENU submenus)" Margin="0,0,0,14"/>

                                    <WrapPanel>
                                        <Button Content="Register / Apply Changes" Style="{StaticResource PrimaryButton}" Margin="0,0,10,6" Click="RegisterExplorer_Click"/>
                                        <Button Content="Unregister All" Style="{StaticResource DangerButton}" Margin="0,0,10,6" Click="UnregisterExplorer_Click"/>
                                        <Button Content="Restart Explorer" Style="{StaticResource SecondaryButton}" Margin="0,0,10,6" Click="RestartExplorer_Click"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Migration from xToolsMenu" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <TextBlock Text="Import your existing custom commands from HKCU\Software\xToolsMenu\CustomCommands into xMenuForge's versioned config.json."
                                               TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"/>
                                    <Button Content="Import xToolsMenu Custom Commands" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="ImportXToolsMenu_Click"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- 9. DIAGNOSTICS -->
                    <Grid x:Name="PageDiagnostics" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="0,0,0,12">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="Diagnostics" FontSize="22" FontWeight="SemiBold"/>
                                <TextBlock Text="Registration health, execution logs, exit codes, and configuration backup." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="Refresh Health" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="RefreshHealth_Click"/>
                                <Button Content="Open Data Folder" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" Click="OpenDataFolder_Click"/>
                                <Button Content="Export Config" Style="{StaticResource SecondaryButton}" Click="ExportConfig_Click"/>
                            </StackPanel>
                        </DockPanel>

                        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                            <StackPanel x:Name="HealthChecksPanel"/>
                        </Border>

                        <Border Grid.Row="2" Style="{StaticResource CardBorder}">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <TextBlock Text="Execution Logs (stdout/stderr &amp; exit codes)" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Button Content="Clear Logs" Style="{StaticResource SecondaryButton}" Padding="10,4" HorizontalAlignment="Right" Click="ClearLogs_Click"/>
                                </DockPanel>
                                <ListBox x:Name="DiagnosticsLogList" BorderThickness="0" Background="Transparent"/>
                            </DockPanel>
                        </Border>
                    </Grid>

                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
